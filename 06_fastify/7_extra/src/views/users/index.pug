extends ../layout/page.pug

block content
  form(action='/users', method='get')
    label Поиск
      input(type='text', name='term', value=term)
    button(type='submit') Найти
  if users.length
    table
      tbody
        each user in users
          tr
            td
              a(href='/users/' + user.id)= user.username
            td= user.email
